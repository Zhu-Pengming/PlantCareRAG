{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-care-rag.local/v1.2/response.schema.json",
  "title": "Evidence-bound answerability response",
  "type": "object",
  "required": ["schema_version", "query", "status", "reason_code", "linked_entity", "dimensions", "qualifiers", "answer", "claims", "evidence", "limitations"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "query": {"type": "string"},
    "status": {"enum": ["answered", "insufficient_evidence", "clarification_needed", "unsupported", "conflicting_evidence"]},
    "reason_code": {"type": "string", "minLength": 1},
    "linked_entity": {"type": ["object", "null"]},
    "dimensions": {"type": "array", "items": {"type": "string"}},
    "qualifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {"enum": ["indoor", "landscape"]},
        "season": {"enum": ["winter", "spring", "summer", "autumn", "spring_to_autumn"]},
        "exception": {"enum": ["winter_dormancy"]},
        "condition": {"enum": ["low_light", "direct_sun", "cold_water", "overwatering"]}
      }
    },
    "answer": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "evidence": {"type": "array"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "conflict": {"type": "object"}
  }
}
