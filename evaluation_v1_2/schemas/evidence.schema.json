{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-care-rag.local/v1.2/evidence.schema.json",
  "title": "Reviewed atomic evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "plant_id", "plant_name", "scientific_name", "entity_scope", "dimension", "qualifiers", "claim_text", "source_id", "source_title", "source_type", "authority_for", "locator", "review_status", "accessed_at"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "claim_id": {"type": "string", "pattern": "^claim:[a-z0-9_:]+$"},
    "plant_id": {"type": "string", "pattern": "^plant:[a-z0-9_]+$"},
    "plant_name": {"type": "string", "minLength": 1},
    "scientific_name": {"type": "string", "minLength": 2},
    "entity_scope": {"enum": ["species", "genus", "common_name_mapping"]},
    "dimension": {"enum": ["growth", "soil", "lighting", "watering", "fertilizer", "taxonomy", "pet_safety"]},
    "qualifiers": {"type": "object"},
    "claim_text": {"type": "string", "minLength": 8},
    "source_id": {"type": "string", "minLength": 1},
    "source_title": {"type": "string", "minLength": 3},
    "source_type": {"enum": ["extension", "rhs", "botanical_garden", "gbif", "kew", "aspca", "veterinary", "dataset_seed"]},
    "authority_for": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["horticultural_care", "taxonomy", "pet_safety", "dataset_seed"]}
    },
    "locator": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "section": {"type": ["string", "null"]},
        "paragraph": {"type": ["string", "null"]}
      }
    },
    "review_status": {"enum": ["unreviewed", "agent_source_checked_pending_human_review", "human_verified", "rejected"]},
    "accessed_at": {"type": "string", "format": "date"},
    "review_notes": {"type": ["string", "null"]}
  }
}
