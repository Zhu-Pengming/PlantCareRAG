{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-care-rag.local/v1.2/query-candidate.schema.json",
  "title": "Observed query candidate awaiting human annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "source_dataset_id", "source_record_id", "raw_title", "raw_body", "source_body_html", "raw_text", "source_url", "author", "created_at", "content_license", "source_metrics", "tags", "alias_matches", "annotation_status", "benchmark_eligible", "split_hash"],
  "properties": {
    "schema_version": {"const": "1.2.0-candidate"},
    "candidate_id": {"type": "string", "pattern": "^qv12:stackexchange_gardening:[0-9]+$"},
    "source_dataset_id": {"const": "stackexchange:gardening:2024-03"},
    "source_record_id": {"type": "string", "pattern": "^[0-9]+$"},
    "raw_title": {"type": "string", "minLength": 1},
    "raw_body": {"type": "string"},
    "source_body_html": {"type": "string"},
    "raw_text": {"type": "string", "minLength": 3},
    "source_url": {"type": "string", "format": "uri"},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_user_id", "display_name"],
      "properties": {
        "owner_user_id": {"type": ["string", "null"]},
        "display_name": {"type": ["string", "null"]}
      }
    },
    "created_at": {"type": "string"},
    "content_license": {"enum": ["CC BY-SA 2.5", "CC BY-SA 3.0", "CC BY-SA 4.0"]},
    "source_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "view_count", "answer_count", "accepted_answer_id"],
      "properties": {
        "score": {"type": "integer"},
        "view_count": {"type": "integer", "minimum": 0},
        "answer_count": {"type": "integer", "minimum": 0},
        "accepted_answer_id": {"type": ["string", "null"]}
      }
    },
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "alias_matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plant_id", "alias", "locations"],
        "properties": {
          "plant_id": {"type": "string"},
          "alias": {"type": "string"},
          "locations": {"type": "array", "uniqueItems": true, "items": {"enum": ["title", "body"]}}
        }
      }
    },
    "annotation_status": {"const": "pending_human_annotation"},
    "benchmark_eligible": {"const": false},
    "split_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
