{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-care-rag.local/v1.3/rag_response.schema.json",
  "title": "Citation-first PlantCareRAG response",
  "type": "object",
  "required": ["schema_version", "query", "status", "reason_code", "linked_entity", "dimensions", "qualifiers", "route", "generation", "answer", "claims", "evidence", "limitations"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "query": {"type": "string"},
    "status": {"enum": ["answered", "insufficient_evidence", "clarification_needed", "unsupported", "conflicting_evidence"]},
    "reason_code": {"type": "string", "minLength": 1},
    "linked_entity": {"type": ["object", "null"]},
    "dimensions": {"type": "array", "items": {"type": "string"}},
    "qualifiers": {"type": "object"},
    "route": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "required": ["mode", "provider", "model", "fallback"],
      "properties": {
        "mode": {"enum": ["none", "extractive", "llm_json"]},
        "provider": {"enum": ["local", "deepseek"]},
        "model": {"type": ["string", "null"]},
        "fallback": {"type": "boolean"},
        "response_id": {"type": ["string", "null"]},
        "requested_mode": {"type": "string"},
        "fallback_reason": {"type": "string"}
      }
    },
    "answer": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "plant_id", "dimension", "qualifiers", "claim_text", "review_status", "citation"],
        "properties": {
          "review_status": {"const": "human_verified"},
          "citation": {
            "type": "object",
            "required": ["source_id", "source_title", "source_type", "url", "section", "paragraph", "accessed_at"]
          }
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
