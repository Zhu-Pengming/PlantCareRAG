{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-rag.local/schemas/evaluation-query.schema.json",
  "title": "Retrieval evaluation query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "raw_text",
    "platform",
    "url",
    "source_location",
    "language",
    "plant_id",
    "alias_used",
    "expected_dimensions",
    "gold_entry_ids",
    "status",
    "answer_shape",
    "question_type",
    "context_requirement"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "query_id": {"type": "string", "pattern": "^q:main:[0-9]{3}$"},
    "raw_text": {"type": "string", "minLength": 3},
    "platform": {"enum": ["reddit", "zhihu", "tieba"]},
    "url": {"type": "string", "format": "uri"},
    "source_location": {"enum": ["post_title", "post_body", "comment"]},
    "language": {"enum": ["en", "zh-CN"]},
    "plant_id": {
      "oneOf": [
        {"type": "string", "pattern": "^plant:[a-z0-9_]+$"},
        {"type": "null"}
      ]
    },
    "alias_used": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "expected_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "gold_entry_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^kb:[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "status": {"enum": ["covered", "partial", "gap"]},
    "answer_shape": {"enum": ["identity", "numeric_request", "conditional", "yes_no", "diagnosis_list", "recommendation"]},
    "answer_shape_support": {"enum": ["supported", "conditional_substitute", "unsupported"]},
    "question_type": {"enum": ["direct", "alias_or_coreference", "symptom", "compound", "judgment_or_premise"]},
    "context_requirement": {"enum": ["none", "image", "thread_context"]},
    "excluded_from_single_turn": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"context_requirement": {"const": "thread_context"}},
        "required": ["context_requirement"]
      },
      "then": {
        "required": ["excluded_from_single_turn"],
        "properties": {"excluded_from_single_turn": {"const": true}}
      },
      "else": {
        "not": {"required": ["excluded_from_single_turn"]}
      }
    }
  ]
}
