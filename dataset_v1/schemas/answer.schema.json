{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-rag.local/dataset-v1/answer.schema.json",
  "title": "Dataset-backed query response",
  "type": "object",
  "required": [
    "schema_version",
    "query",
    "status",
    "reason_code",
    "linked_entity",
    "dimension",
    "answer",
    "results",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "query": {"type": "string"},
    "status": {"enum": ["answered", "refused"]},
    "reason_code": {"type": "string", "minLength": 1},
    "linked_entity": {"type": ["object", "null"]},
    "dimension": {"type": ["string", "null"]},
    "answer": {"type": "string", "minLength": 1},
    "results": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "conflict": {"type": "object"}
  }
}
