{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-care-rag.local/dataset-v1/entry.schema.json",
  "title": "Dataset-backed atomic care entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "plant_id",
    "plant_name",
    "dimension",
    "value",
    "content",
    "source",
    "review_status",
    "evidence_level"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^kb:[a-z0-9_]+:(growth|soil|lighting|watering|fertilizer)$"},
    "plant_id": {"type": "string", "pattern": "^plant:[a-z0-9_]+$"},
    "plant_name": {"type": "string", "minLength": 1},
    "dimension": {"enum": ["growth", "soil", "lighting", "watering", "fertilizer"]},
    "value": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 8},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "page_url", "license", "raw_row_numbers"],
      "properties": {
        "dataset_id": {"type": "string", "pattern": "^kaggle:"},
        "page_url": {"type": "string", "format": "uri"},
        "license": {"const": "CC BY 4.0"},
        "raw_row_numbers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 2}
        }
      }
    },
    "review_status": {"const": "dataset_accepted"},
    "evidence_level": {"const": "single_dataset_claim"}
  }
}
