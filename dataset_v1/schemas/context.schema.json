{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-care-rag.local/dataset-v1/context.schema.json",
  "title": "Filtered plant context stress-test sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "plant_scientific_name",
    "health_note",
    "pest_presence",
    "pest_severity",
    "source",
    "allowed_use",
    "prohibited_use"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^context:[0-9]{4}$"},
    "plant_scientific_name": {"type": "string", "minLength": 3},
    "health_note": {"type": "string", "minLength": 1},
    "watering_amount_ml": {"type": "integer", "minimum": 0},
    "watering_frequency_days": {"type": "integer", "minimum": 1},
    "sunlight_exposure": {"type": "string", "minLength": 1},
    "room_temperature_c": {"type": "number", "minimum": -20, "maximum": 60},
    "humidity_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "pest_presence": {"type": "string", "minLength": 1},
    "pest_severity": {"enum": ["None", "Low", "Moderate", "High"]},
    "soil_moisture_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "soil_type": {"type": "string", "minLength": 1},
    "health_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "page_url", "license", "raw_row_number"],
      "properties": {
        "dataset_id": {"type": "string", "pattern": "^kaggle:"},
        "page_url": {"type": "string", "format": "uri"},
        "license": {"const": "CC BY 4.0"},
        "raw_row_number": {"type": "integer", "minimum": 2}
      }
    },
    "allowed_use": {"const": "context_stress_test_only"},
    "prohibited_use": {"const": "ground_truth_or_medical_safety_claim"}
  }
}
