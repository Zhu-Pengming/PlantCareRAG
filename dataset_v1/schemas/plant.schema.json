{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-rag.local/dataset-v1/plant.schema.json",
  "title": "Dataset-backed plant entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "normalized_name",
    "source_dataset_id",
    "source_row_numbers",
    "review_status",
    "evidence_level"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^plant:[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "normalized_name": {"type": "string", "minLength": 1},
    "source_dataset_id": {"type": "string", "pattern": "^kaggle:"},
    "source_row_numbers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 2}
    },
    "review_status": {"const": "dataset_accepted"},
    "evidence_level": {"const": "single_dataset_claim"}
  }
}
