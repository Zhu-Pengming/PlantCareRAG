{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-rag.local/schemas/entry.schema.json",
  "title": "Atomic knowledge entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "plant_id",
    "language",
    "dimension",
    "topics",
    "claim_type",
    "content",
    "conditions",
    "retrieval",
    "source_refs",
    "review_status",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^kb:[a-z0-9_]+$"},
    "plant_id": {"type": "string", "pattern": "^plant:[a-z0-9_]+$"},
    "language": {"const": "zh-CN"},
    "dimension": {
      "enum": [
        "taxonomy",
        "plant_attribute",
        "lighting",
        "watering",
        "humidity",
        "temperature",
        "soil",
        "fertilizer",
        "repotting",
        "symptom",
        "disease",
        "pest",
        "pet_safety"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "claim_type": {"enum": ["fact", "recommendation", "diagnostic_association", "safety"]},
    "answer_shape": {"enum": ["identity", "numeric_request", "conditional", "yes_no", "diagnosis_list", "recommendation"]},
    "content": {"type": "string", "minLength": 8, "maxLength": 400},
    "conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliases", "intents", "symptoms"],
      "properties": {
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "intents": {
          "type": "array",
          "items": {"enum": ["identify", "learn", "care", "diagnose", "safety"]},
          "uniqueItems": true
        },
        "symptoms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "support"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^source:[a-z0-9_]+$"},
          "locator": {"type": "string", "minLength": 2},
          "support": {"const": "paraphrase"}
        }
      }
    },
    "review_status": {"enum": ["draft", "approved", "needs_review"]},
    "updated_at": {"type": "string", "format": "date"}
  }
}
