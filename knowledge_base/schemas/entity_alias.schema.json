{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-rag.local/schemas/entity_alias.schema.json",
  "title": "Plant entity alias",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "value",
    "normalized_value",
    "language",
    "plant_id",
    "alias_type",
    "automatic",
    "provenance",
    "source_ids",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^alias:[a-z0-9_]+$"},
    "value": {"type": "string", "minLength": 1},
    "normalized_value": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "plant_id": {
      "oneOf": [
        {"type": "string", "pattern": "^plant:[a-z0-9_]+$"},
        {"type": "null"}
      ]
    },
    "alias_type": {
      "enum": ["scientific_name", "taxonomic_synonym", "common_name", "project_alias", "ambiguous"]
    },
    "automatic": {"type": "boolean"},
    "provenance": {"enum": ["taxonomy_source", "care_source", "project_curated"]},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^source:[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "review_status": {"enum": ["draft", "approved", "needs_review"]},
    "evaluation_status": {"enum": ["tested", "untested"]},
    "notes": {"type": "string"}
  }
}
