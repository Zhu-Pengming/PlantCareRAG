{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-rag.local/schemas/source.schema.json",
  "title": "Knowledge source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "organization",
    "title",
    "url",
    "source_type",
    "authority_tier",
    "accessed_at",
    "copyright_status",
    "usage"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^source:[a-z0-9_]+$"},
    "organization": {"type": "string", "minLength": 2},
    "title": {"type": "string", "minLength": 2},
    "url": {"type": "string", "format": "uri"},
    "source_type": {"enum": ["taxonomy_database", "university_extension", "botanical_garden", "veterinary_reference", "veterinary_poison_database", "horticultural_guidance"]},
    "authority_tier": {"enum": [1, 2, 3]},
    "accessed_at": {"type": "string", "format": "date"},
    "copyright_status": {"enum": ["verified_open", "permission_required", "review_required"]},
    "usage": {"enum": ["structured_import", "link_and_paraphrase_only"]},
    "notes": {"type": "string"}
  }
}
