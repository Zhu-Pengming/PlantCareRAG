{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-rag.local/schemas/plant.schema.json",
  "title": "Plant entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "scientific_name",
    "rank",
    "taxonomy",
    "names",
    "synonyms",
    "identity_source_ids",
    "review_status",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^plant:[a-z0-9_]+$"},
    "scientific_name": {"type": "string", "minLength": 3},
    "rank": {"const": "species"},
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kingdom", "phylum", "class", "order", "family", "genus"],
      "properties": {
        "kingdom": {"type": "string"},
        "phylum": {"type": "string"},
        "class": {"type": "string"},
        "order": {"type": "string"},
        "family": {"type": "string"},
        "genus": {"type": "string"}
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "language", "kind"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 2},
          "kind": {"enum": ["preferred", "common", "project_alias"]}
        }
      }
    },
    "synonyms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "identity_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^source:[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "review_status": {"enum": ["draft", "approved", "needs_review"]},
    "updated_at": {"type": "string", "format": "date"}
  }
}
